{
  "name": "yutugs-photo-rebuild",
  "private": true,
  "version": "1.1.18-alpha",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run check:conflicts && tsc -b && vite build",
